# Irhamhuma Backend Environment Variables (Copy to functions/.env)
GEMINI_API_KEY=your_gemini_api_key_here
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000
PUBLIC_WEBHOOK_BASE_URL=https://us-central1-your-firebase-project-id.cloudfunctions.net/twimlRouter

# Secret passcode required in the Web Dashboard header (x-irhamhuma-key) to sync or trigger calls
DASHBOARD_API_KEY=change_me_to_a_strong_family_passcode

# Comma-separated E.164 country prefixes allowed for outbound Twilio PSTN calls (prevents toll fraud)
ALLOWED_CALL_PREFIXES=+92,+46,+91,+1,+44

# Optional initial fallback numbers if Firestore settings/careConfig has not been saved yet
DEFAULT_CAREGIVER_PHONE=
DEFAULT_ESCALATION_PHONE=

# Optional Telegram Bot Token (@BotFather) & Escalation Chat ID for $0.00 free messaging without 24-hour window limits
TELEGRAM_BOT_TOKEN=
ESCALATION_TELEGRAM_CHAT_ID=
